#!/bin/sh
# Protects main from the pushes that can rewrite history: a force or
# non-fast-forward push to main, and deleting main. Force-pushing feature branches
# is untouched. Then runs the local push guard, if this machine has one.
#
# One-time setup per clone:  git config core.hooksPath .githooks
# Emergency bypass:          git push --no-verify   (use with care)

protected=refs/heads/main
refs=$(cat)

echo "$refs" | {
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$remote_ref" = "$protected" ] || continue
	case "$local_sha" in
	*[!0]*) ;;
	*)
		echo "pre-push: refusing to delete $protected." >&2
		exit 1
		;;
	esac
	case "$remote_sha" in
	*[!0]*)
		if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
			echo "pre-push: refusing a non-fast-forward (force) push to $protected." >&2
			echo "  Land changes through a pull request instead." >&2
			exit 1
		fi
		;;
	esac
done
exit 0
} || exit 1

# Hand over to the machine's own guard, which also runs the Git LFS upload.
local_guard="$(git rev-parse --git-common-dir)/hooks/pre-push"
if [ -x "$local_guard" ]; then
	echo "$refs" | "$local_guard" "$@" || exit 1
elif command -v git-lfs >/dev/null 2>&1; then
	echo "$refs" | git lfs pre-push "$@"
fi
